{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GCR Simplified",
  "version": "0.1.3",
  "identifier": "com.gcrsimplified.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GCR Simplified — Grade · Check · Report",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBN0JBOTg2RjhFQTYxRjYKUldUMlllcjRocWw3ZWw5YllXckQzbjh1WndJMWNwMmdyWnA2Y2RlaGJZS0ZhdnJhNFdYUzR5RUQK",
      "endpoints": [
        "https://github.com/Udbhav7002/GCR_Simplified/releases/latest/download/latest.json"
      ]
    }
  }
}
